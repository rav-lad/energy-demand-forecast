# =====================================================
# ENVIRONMENT VARIABLES
# =====================================================
# Copy this file to .env and fill in your API keys
# DO NOT commit .env to git (it's in .gitignore)

# ENTSO-E Transparency Platform API
# Get your free API key at: https://transparency.entsoe.eu/
# 1. Create account
# 2. Go to "My Account Settings"
# 3. Generate API key
ENTSOE_API_KEY=your_entsoe_api_key_here

# Optional: OpenWeatherMap (if using instead of Open-Meteo)
# OPENWEATHERMAP_API_KEY=your_openweather_api_key_here

# Optional: Kaggle API (for downloading datasets)
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_key

# GraphCast Configuration (Future)
# GRAPHCAST_MODEL_PATH=/path/to/graphcast/model
# GRAPHCAST_DATA_PATH=/path/to/graphcast/data

# Database Configuration (if using)
# DATABASE_URL=postgresql://user:password@localhost:5432/energy_trading

# Email Alerts (if enabling monitoring)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# ALERT_EMAIL=recipient@example.com

# Development Settings
DEBUG=False
LOG_LEVEL=INFO
